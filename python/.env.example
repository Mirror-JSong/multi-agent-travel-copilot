# LLM 配置（默认使用 mock 模式，无需真实 API 即可运行）
LLM_PROVIDER=mock
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.minimax.chat/v1
LLM_MODEL=MiniMax-M2.7
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# 预算循环最大重试次数
BUDGET_MAX_RETRIES=3
BUDGET_POLICY_VERSION=budget-policy-v1
BUDGET_MIN_HOTEL_RATING=7.0

# 并行 Agent 超时（秒）
PARALLEL_TIMEOUT=30
WEATHER_PROVIDER_TIMEOUT=5

# 确定性 Mock 数据集版本（改变版本会得到一套新的稳定候选）
MOCK_DATA_VERSION=2026.09-v1
MOCK_ACTIVITY_DATA_VERSION=2026.09-activity-weather-pace-v3

# API 服务
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit 调用 FastAPI 的地址
TRAVEL_API_BASE_URL=http://127.0.0.1:8000

# 可选：多进程或重启后继续验证偏好草稿时必须配置；不要使用示例值部署
PREFERENCE_DRAFT_SIGNING_KEY=replace-with-a-private-random-value

LOG_LEVEL=INFO
